{
  "name": "splitnote",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eval": "tsc -p evals/tsconfig.json && node .evalbuild/evals/run.js",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web && node scripts/postexport.js"
  },
