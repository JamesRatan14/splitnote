{
  "expo": {
    "name": "SplitNote",
    "slug": "splitnote",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "splitnote",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.splitnote",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D9E75"
      }
    },
    "splash": {
      "backgroundColor": "#1D9E75"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ]
  }
}
